# Supabase (client-side — safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token guarding GET /api/health/supabase (temporary diagnostic route)
DIAGNOSTIC_TOKEN=
